{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile:vscode-extension",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "compile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/vscode-extension"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "open:vscode-extension-hosts",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/open-two-extension-hosts.ps1"
      ],
      "dependsOn": [
        "compile:vscode-extension"
      ],
      "problemMatcher": []
    }
  ]
}
