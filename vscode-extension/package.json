{
  "name": "icpc-live-vscode",
  "displayName": "ICPC Live",
  "description": "Join an ICPC Live team room from VS Code: one shared workspace in the Explorer, one member in control at a time.",
  "version": "0.2.3",
  "publisher": "icpc-live",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onFileSystem:icpc-room",
    "onFileSystem:icpc-room-input"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "ICPC Live",
      "properties": {
        "icpcLive.serverUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Address of the ICPC Live server your team uses."
        },
        "icpcLive.followController": {
          "type": "boolean",
          "default": true,
          "description": "While you do not hold control, open the file the controller switches to."
        }
      }
    },
    "commands": [
      {
        "command": "icpcLive.createRoom",
        "title": "Create Room",
        "category": "ICPC Live",
        "icon": "$(add)"
      },
      {
        "command": "icpcLive.joinRoom",
        "title": "Join Room",
        "category": "ICPC Live",
        "icon": "$(plug)"
      },
      {
        "command": "icpcLive.leaveRoom",
        "title": "Leave Room",
        "category": "ICPC Live",
        "icon": "$(sign-out)"
      },
      {
        "command": "icpcLive.copyInvite",
        "title": "Copy Invite Link",
        "category": "ICPC Live",
        "icon": "$(link)"
      },
      {
        "command": "icpcLive.showRoomMenu",
        "title": "Room Actions\u2026",
        "category": "ICPC Live"
      },
      {
        "command": "icpcLive.requestControl",
        "title": "Request Control",
        "category": "ICPC Live",
        "icon": "$(key)"
      },
      {
        "command": "icpcLive.requestControlButton",
        "title": "Request Control"
      },
      {
        "command": "icpcLive.approveControl",
        "title": "Give Control",
        "category": "ICPC Live",
        "icon": "$(check)"
      },
      {
        "command": "icpcLive.rejectControl",
        "title": "Decline Control Request",
        "category": "ICPC Live",
        "icon": "$(close)"
      },
      {
        "command": "icpcLive.runCode",
        "title": "Run File",
        "category": "ICPC Live",
        "icon": "$(play)"
      },
      {
        "command": "icpcLive.editInput",
        "title": "Edit Program Input",
        "category": "ICPC Live",
        "icon": "$(terminal)"
      },
      {
        "command": "icpcLive.setStdinMode",
        "title": "Choose Input Source",
        "category": "ICPC Live"
      },
      {
        "command": "icpcLive.clockMenu",
        "title": "Contest Clock\u2026",
        "category": "ICPC Live",
        "icon": "$(watch)"
      },
      {
        "command": "icpcLive.openRunOutput",
        "title": "Show Run Output",
        "category": "ICPC Live"
      }
    ],
    "keybindings": [
      {
        "command": "icpcLive.runCode",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourceScheme == icpc-room"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "icpcLive",
          "title": "ICPC Live",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "icpcLive": [
        {
          "id": "icpcLive.room",
          "name": "Room"
        },
        {
          "id": "icpcLive.members",
          "name": "Members",
          "when": "icpcLive.joined"
        },
        {
          "id": "icpcLive.runHistory",
          "name": "Run History",
          "when": "icpcLive.joined"
        }
      ],
      "explorer": [
        {
          "id": "icpcLive.control",
          "name": "ICPC Live",
          "when": "icpcLive.joined",
          "visibility": "visible",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "icpcLive.room",
        "when": "!icpcLive.joined",
        "contents": "One shared workspace for your team: one member edits and runs code, everyone sees it live.\n[Join Room](command:icpcLive.joinRoom)\n[Create Room](command:icpcLive.createRoom)\nThe room opens as a folder in the Explorer."
      },
      {
        "view": "icpcLive.control",
        "when": "icpcLive.joined && !icpcLive.isController && !icpcLive.controlRequested",
        "contents": "Files are read-only while a teammate has control.\n[Request Control](command:icpcLive.requestControl)"
      },
      {
        "view": "icpcLive.control",
        "when": "icpcLive.joined && !icpcLive.isController && icpcLive.controlRequested",
        "contents": "Control requested. Waiting for the teammate with control to answer."
      },
      {
        "view": "icpcLive.control",
        "when": "icpcLive.joined && icpcLive.isController && icpcLive.canEdit",
        "contents": "You have control: you can edit and run.\n[Run File](command:icpcLive.runCode)"
      },
      {
        "view": "icpcLive.control",
        "when": "icpcLive.joined && icpcLive.isController && !icpcLive.canEdit",
        "contents": "Connection lost. Editing is paused until you are back online; your seat is kept."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "icpcLive.openRunOutput",
          "when": "false"
        },
        {
          "command": "icpcLive.leaveRoom",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.copyInvite",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.showRoomMenu",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.requestControl",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.approveControl",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.rejectControl",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.runCode",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.editInput",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.setStdinMode",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.clockMenu",
          "when": "icpcLive.joined"
        },
        {
          "command": "icpcLive.requestControlButton",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "icpcLive.runCode",
          "when": "resourceScheme == icpc-room && icpcLive.canEdit",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "icpcLive.copyInvite",
          "when": "view == icpcLive.room && icpcLive.joined",
          "group": "navigation"
        },
        {
          "command": "icpcLive.requestControl",
          "when": "view == workbench.explorer.fileView && icpcLive.joined && !icpcLive.isController && !icpcLive.controlRequested",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "icpcLive.approveControl",
          "when": "view == icpcLive.members && viewItem == controlRequest",
          "group": "inline@1"
        },
        {
          "command": "icpcLive.rejectControl",
          "when": "view == icpcLive.members && viewItem == controlRequest",
          "group": "inline@2"
        },
        {
          "command": "icpcLive.approveControl",
          "when": "view == icpcLive.control && viewItem == controlRequest",
          "group": "inline@1"
        },
        {
          "command": "icpcLive.rejectControl",
          "when": "view == icpcLive.control && viewItem == controlRequest",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "icpcLive.requestControlButton",
          "when": "resourceScheme == icpc-room && icpcLive.joined && !icpcLive.isController && !icpcLive.controlRequested",
          "group": "navigation@0"
        }
      ]
    },
    "resourceLabelFormatters": [
      {
        "scheme": "icpc-room",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "ICPC Live"
        }
      },
      {
        "scheme": "icpc-room-input",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "ICPC Live"
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.mjs",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:vscode": "npm run compile && node out/test-host/run.js",
    "package": "npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yanqing-Shi/ACM-Live-Practice.git",
    "directory": "vscode-extension"
  },
  "keywords": [
    "icpc",
    "competitive programming",
    "collaboration",
    "team"
  ]
}
